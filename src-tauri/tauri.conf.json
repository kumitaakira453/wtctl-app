{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "wtctl",
  "version": "0.1.7",
  "identifier": "com.wtctl.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5317",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "wtctl",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kumitaakira453/wtctl-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCQzI4RkQ5QjJBN0Q5NkMKUldSczJhZXkyWS9DdTdiVWVOVXRHMDlCenc1bGJaL3JaZVdzekUyYU5VakMvdXdwQkhJUkc5eU0K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
